# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → Data API for the URL and anon key; Project Settings →
# API Keys for the service role key. The service role key bypasses RLS and must
# never be exposed to the browser or committed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only used by `npm run db:link` / `db:types`.
SUPABASE_PROJECT_REF=

# ─── Admin ───────────────────────────────────────────────────────────────────
# Comma-separated emails allowed into /admin before anyone exists in the
# admin_users table. The first sign-in by one of these creates their row.
ADMIN_ALLOWLIST=

# ─── Razorpay ────────────────────────────────────────────────────────────────
# Dashboard → Settings → API Keys. Use the test keys until go-live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks. A different secret from the key secret; the
# webhook is the authority on whether a payment happened.
RAZORPAY_WEBHOOK_SECRET=

# ─── Shiprocket (phase 5) ────────────────────────────────────────────────────
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
# The PIN code of that pickup address. Serviceability is quoted between two
# PIN codes and the nickname does not carry one.
SHIPROCKET_PICKUP_PINCODE=
SHIPROCKET_WEBHOOK_TOKEN=

# ─── Resend (phase 3) ────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM_ORDERS="Aalmaram <foundersteam@aalmaram.com>"
EMAIL_FROM_MARKETING="Aalmaram <letters@aalmaram.com>"
ADMIN_NOTIFY_EMAIL=

# ─── n8n (existing automations) ──────────────────────────────────────────────
# Store events → n8n (docs/custom-commerce/EVENTS.md). A URL saved in
# Admin → Settings → Integrations wins over these; leave a topic blank and its
# events wait, undelivered, until one is set.
N8N_ORDER_PAID_WEBHOOK_URL=
N8N_ORDER_SHIPPED_WEBHOOK_URL=
N8N_ORDER_DELIVERED_WEBHOOK_URL=
N8N_ORDER_REFUNDED_WEBHOOK_URL=
N8N_ORDER_CANCELLED_WEBHOOK_URL=
N8N_INVENTORY_LOW_WEBHOOK_URL=
# Shared secret, both directions: sent to n8n as x-aalmaram-token (and an HMAC
# signature), and required from n8n on /api/integrations/summary. Long and random.
N8N_WEBHOOK_SECRET=
# Site forms (unchanged).
N8N_NEWSLETTER_WEBHOOK_URL=
N8N_EVENT_WEBHOOK_URL=
N8N_COLLABORATE_WEBHOOK_URL=

# ─── Misc ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://aalmaram.com
NEXT_PUBLIC_GA_ID=
# Guards /api/cron/* (tracking, outbox, abandoned checkouts).
CRON_SECRET=

# ─── Shopify history import (one-off, see docs/custom-commerce/GO-LIVE.md §8) ─
# Only for `npm run migrate:shopify`. Nothing in the app reads these. Remove them
# (and delete the Shopify app) once the import is done.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
