# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → Data API for the URL and anon key; Project Settings →
# API Keys for the service role key. The service role key bypasses RLS and must
# never be exposed to the browser or committed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only used by `npm run db:link` / `db:types`.
SUPABASE_PROJECT_REF=

# ─── Admin ───────────────────────────────────────────────────────────────────
# Comma-separated emails allowed into /admin before anyone exists in the
# admin_users table. The first sign-in by one of these creates their row.
ADMIN_ALLOWLIST=

# ─── Razorpay ────────────────────────────────────────────────────────────────
# Dashboard → Settings → API Keys. Use the test keys until go-live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks. A different secret from the key secret; the
# webhook is the authority on whether a payment happened.
RAZORPAY_WEBHOOK_SECRET=

# ─── Shiprocket (phase 5) ────────────────────────────────────────────────────
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_WEBHOOK_TOKEN=

# ─── Resend (phase 3) ────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM_ORDERS="Aalmaram <foundersteam@aalmaram.com>"
EMAIL_FROM_MARKETING="Aalmaram <letters@aalmaram.com>"
ADMIN_NOTIFY_EMAIL=

# ─── n8n (existing automations) ──────────────────────────────────────────────
N8N_ORDER_PAID_WEBHOOK_URL=
N8N_ORDER_SHIPPED_WEBHOOK_URL=
N8N_ORDER_DELIVERED_WEBHOOK_URL=
N8N_NEWSLETTER_WEBHOOK_URL=
N8N_EVENT_WEBHOOK_URL=
N8N_COLLABORATE_WEBHOOK_URL=

# ─── Misc ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://aalmaram.com
NEXT_PUBLIC_GA_ID=
# Guards /api/cron/* (phases 5–6).
CRON_SECRET=
