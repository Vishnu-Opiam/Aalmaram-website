      "parameters": {
        "jsCode": "// Node 2: Data Parser & Cleaner\n// Shopify Trigger may deliver the order directly as json, or under .body for raw webhooks.\nconst order = $input.first().json.body ?? $input.first().json;\n\nconst customer = order.customer || {};\nconst billing = order.billing_address || {};\nconst shipping = (order.shipping_lines && order.shipping_lines[0]) || {};\n\n// Clean the line items down to what accounting needs\nconst lineItems = (order.line_items || []).map((li) => ({\n  name: li.title + (li.variant_title ? ' - ' + li.variant_title : ''),\n  sku: li.sku || '',\n  quantity: Number(li.quantity) || 0,\n  rate: parseFloat(li.price) || 0\n}));\n\nreturn [\n  {\n    json: {\n      email: order.email || customer.email || '',\n      first_name: customer.first_name || billing.first_name || '',\n      last_name: customer.last_name || billing.last_name || '',\n      phone: customer.phone || billing.phone || '',\n      line_items: lineItems,\n      total_tax: parseFloat(order.total_tax || 0),\n      shipping_cost: parseFloat(shipping.price || 0),\n      total_price: parseFloat(order.total_price || 0),\n      order_number: order.order_number || order.name || '',\n      currency: order.currency || 'INR'\n    }\n  }\n];"
      },
