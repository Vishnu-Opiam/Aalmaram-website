    {
      "parameters": {
        "jsCode": "// Step 5: extract name, email, phone, city, order value, customer id from Shopify payload\nconst order = $input.first().json.body ?? $input.first().json;\nconst c = order.customer || {};\nconst ship = order.shipping_address || order.billing_address || {};\n\nconst email = order.email || c.email || '';\nconst customerId = c.id ? String(c.id) : '';\nconst orderDate = (order.created_at || new Date().toISOString()).substring(0, 10); // YYYY-MM-DD for NocoDB Date\n\n// Match on the stable Shopify customer id when present, otherwise fall back to email\nconst matchWhere = customerId\n  ? `(shopify_customer_id,eq,${customerId})`\n  : `(email,eq,${email})`;\n\nreturn [\n  {\n    json: {\n      name: ((c.first_name || '') + ' ' + (c.last_name || '')).trim() || email,\n      email,\n      phone: c.phone || ship.phone || order.phone || '',\n      city: ship.city || '',\n      shopify_customer_id: customerId,\n      order_value: parseFloat(order.total_price || 0),\n      order_date: orderDate,\n      match_where: matchWhere\n    }\n  }\n];"
      },
