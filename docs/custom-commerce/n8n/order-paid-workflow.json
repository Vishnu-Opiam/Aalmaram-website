    {
      "parameters": {
        "jsCode": "// Build the Purchase interaction payload from a Shopify order\nconst order = $input.first().json.body ?? $input.first().json;\nconst c = order.customer || {};\n\nconst email = order.email || c.email || '';\nconst lineItems = order.line_items || [];\n\n// Total quantity across all line items\nconst quantity = lineItems.reduce((sum, li) => sum + (Number(li.quantity) || 0), 0);\n\n// Human-readable summary: \"Bought 2 × Title A, 1 × Title B — Order #1234\"\nconst itemSummary = lineItems\n  .map(li => `${li.quantity} × ${li.title}${li.variant_title ? ' (' + li.variant_title + ')' : ''}`)\n  .join(', ');\n\nconst orderRef = order.order_number || order.name || order.id || '';\nconst summary = `Bought ${itemSummary}${orderRef ? ' — Order #' + orderRef : ''}`;\n\nreturn [\n  {\n    json: {\n      email,\n      int_id: `WEB-${orderRef || order.id || Date.now()}`,\n      int_type: 'Purchase',\n      summary,\n      quantity,\n      amount: parseFloat(order.total_price || 0),\n      date: (order.created_at || new Date().toISOString()).substring(0, 10)\n    }\n  }\n];"
      },
